{
  "description": "Plugin lifecycle hooks: wiki memory-compiler (exits 0 when .claude/automaton.enabled absent) and caveman terse-mode injector (reads [caveman] from .automaton/config.toml, defaults to enabled=true mode=full).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-session-start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/skills/caveman/scripts/hook-activate",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hook-session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
