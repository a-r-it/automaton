#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net diff
# with extended context, written to a file the reviewer reads in one call.
# Using the recorded per-task BASE (not HEAD~1) keeps multi-commit tasks
# intact.
#
# Usage: review-package --workdir DIR --task N --round I --range BASE HEAD
# Writes DIR/review-task-<N>-r<I>.diff (named per task+round, so a re-review
# after fixes gets a distinct fresh file).
set -euo pipefail

usage() {
  echo "usage: review-package --workdir DIR --task N --round I --range BASE HEAD" >&2
  exit 2
}

workdir=""; task=""; round=""; base=""; head=""
while [ $# -gt 0 ]; do
  case $1 in
    --workdir) workdir=${2:?}; shift 2 ;;
    --task)    task=${2:?}; shift 2 ;;
    --round)   round=${2:?}; shift 2 ;;
    --range)   base=${2:?}; head=${3:?}; shift 3 ;;
    *) usage ;;
  esac
done
[ -n "$workdir" ] && [ -n "$task" ] && [ -n "$round" ] \
  && [ -n "$base" ] && [ -n "$head" ] || usage
[ -d "$workdir" ] || { echo "no such directory: $workdir" >&2; exit 2; }

out="$workdir/review-task-${task}-r${round}.diff"

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }
{
  echo "# Review package: task ${task} round ${round} (${base}..${head})"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"
commits=$(git rev-list --count "${base}..${head}")

echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
