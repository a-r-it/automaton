#!/usr/bin/env bash
# PreToolUse hook on EnterPlanMode: block Claude Code's native plan mode.
#
# The development plugin has its own planning flow (brainstorming → writing-plans
# → executing-plans, plans as files); native plan mode restricts Write/Edit and
# traps the session, conflicting with that flow. The skills HARD-GATE against it
# in prose; this hook is the enforcement. Replaces the old onboard-written
# permissions.deny:["EnterPlanMode"].
#
# Escape hatch: DEVELOPMENT_PLANMODE_GUARD=0 (or the global DEVELOPMENT_HOOKS=0,
# handled by run-hook.cmd). Fail-open on any internal error.
#
# Trace log: /tmp/claude-hooks/user-gate-trace.log (override DEVELOPMENT_USERGATE_TRACE_LOG).

TRACE_LOG="${DEVELOPMENT_USERGATE_TRACE_LOG:-/tmp/claude-hooks/user-gate-trace.log}"
mkdir -p "$(dirname "$TRACE_LOG")" 2>/dev/null || true
trace() {
    printf '%s | pre-planmode | %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${1:-}" >> "$TRACE_LOG" 2>/dev/null || true
}

ALLOW='{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow"}}'

if [[ "${DEVELOPMENT_PLANMODE_GUARD:-1}" == "0" ]]; then
    trace "skip guard=0"; echo "$ALLOW"; exit 0
fi

# Fail-open: any unexpected error allows rather than bricking the session.
trap 'trace "error trap-ERR"; echo "$ALLOW"; exit 0' ERR

INPUT=$(cat)
TOOL_NAME=$(echo "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null)
[[ "$TOOL_NAME" != "EnterPlanMode" ]] && { trace "skip tool=$TOOL_NAME"; echo "$ALLOW"; exit 0; }

trace "block EnterPlanMode"
echo "Native plan mode is disabled by the development plugin. Use its own flow instead: the brainstorming skill to explore/spec, then writing-plans to produce a plan file, then executing-plans or subagent-driven-development to implement. (Override: DEVELOPMENT_PLANMODE_GUARD=0.)" >&2
exit 2
