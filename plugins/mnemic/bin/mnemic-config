#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_DIR="$SCRIPT_DIR/../engine"
# Fail closed when uv is missing: a non-zero exit makes mnemic-enabled treat
# the plugin as disabled (is-enabled semantics: non-zero = not enabled) rather
# than falsely reporting it enabled because config could not be read.
"$SCRIPT_DIR/check-uv" >/dev/null 2>&1 || exit 1
exec uv run --quiet --directory "$ENGINE_DIR" python -m automaton_config "$@"
