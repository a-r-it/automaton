#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
ENGINE_DIR="$PLUGIN_ROOT/engine"
"$PLUGIN_ROOT/bin/check-uv" >/dev/null 2>&1 || exit 0
exec uv run --quiet --directory "$ENGINE_DIR" \
  python "$SCRIPT_DIR/switch.py" "$@"
