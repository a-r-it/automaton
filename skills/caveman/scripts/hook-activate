#!/bin/bash
# Claude Code SessionStart hook — injects caveman terse-mode rules into session context.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
ENGINE_DIR="$PLUGIN_ROOT/engine"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
"$PLUGIN_ROOT/bin/check-uv" >/dev/null 2>&1 || exit 0
exec uv run --quiet --directory "$ENGINE_DIR" \
  python "$SCRIPT_DIR/activate.py" \
  "$PROJECT_DIR"
