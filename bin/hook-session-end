#!/bin/bash
# Claude Code SessionEnd hook. Opt-in via .automaton/config.toml enabled=true.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MEMORY_DIR="$SCRIPT_DIR/../memory"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
automaton-enabled "$PROJECT_DIR" || exit 0
"$SCRIPT_DIR/check-uv" >/dev/null 2>&1 || exit 0
export WIKI_ROOT="$PROJECT_DIR"
exec uv run --directory "$MEMORY_DIR" python -m scripts.hook_entries.session_end
